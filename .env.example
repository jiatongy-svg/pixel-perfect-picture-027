# ============================================================================
# TripMatch environment variables. Copy this file to `.env.local` for local
# development, and add the same names in Vercel -> Project -> Settings ->
# Environment Variables. NEVER commit real values.
# ============================================================================

# --- Public (safe in the browser; data is protected by Row Level Security) ---
# Supabase -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase -> Project Settings -> API -> anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OPTIONAL. Leave unset: the app uses the address it's visited at. Only set it to force a specific URL.
# NEXT_PUBLIC_SITE_URL=

# --- SECRET (server only; never share, never prefix with NEXT_PUBLIC_) ---
# Supabase -> Project Settings -> API -> service_role key. Skips all security rules.
SUPABASE_SERVICE_ROLE_KEY=

# The pilot emails, comma-separated, exactly 6. Used ONLY by the seed script
# (npm run seed) to create accounts and fill the allowlist table.
PILOT_ALLOWLIST=

# --- Optional AI merge (off by default; the app works fully without it) ---
ENABLE_AI_MERGE=false
# Only needed if ENABLE_AI_MERGE=true. From console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# Optional, for presenting without phone signal: these demo accounts sign in
# with a fixed 8-digit code instead of an emailed one. Leave empty = off.
# Set them in Vercel only during the presentation; never commit real values.
DEMO_SIGNIN_EMAILS=
DEMO_SIGNIN_CODE=
